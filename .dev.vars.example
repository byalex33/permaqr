# Dashboard password. Generate one with: openssl rand -base64 24
# Copy this file to .dev.vars for local `wrangler dev`. Never commit .dev.vars.
ADMIN_PASSWORD="replace-with-a-long-random-password"

# Hosted mode is optional and off by default. Uncomment these only on the
# instance you sell access to. Self-hosters should leave them unset.
# HOSTED_MODE="true"
# LEMONSQUEEZY_CHECKOUT_URL="https://YOURSTORE.lemonsqueezy.com/checkout/buy/YOUR-VARIANT-UUID"
# LEMONSQUEEZY_WEBHOOK_SECRET="the signing secret from the Lemon Squeezy webhook"
# LEMONSQUEEZY_VARIANT_ID="123456"
